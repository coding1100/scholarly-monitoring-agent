# Core
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db

# API
API_HOST=0.0.0.0
API_PORT=8000
HOST_API_PORT=8030

# Checker defaults
CHECKER_DEFAULT_TIMEOUT_SECONDS=5
CHECKER_USER_AGENT=site-watch-agent/0.1.0
CHECKER_MAX_RESPONSE_CHARS=500
TRANSIENT_RETRY_ATTEMPTS=1
TRANSIENT_RETRY_BACKOFF_SECONDS=0.5
STATE_TRANSITION_DELAY_SECONDS=0
STATUS_NOTIFICATION_INTERVAL_SECONDS=900

# Worker
SCHEDULER_SYNC_SECONDS=30
JOB_JITTER_SECONDS=3
URL_CHECKS=https://scholarlyhelp.com/,https://mindrind.net/
# URL_CHECKS takes precedence over URL_CHECK fallback:
# URL_CHECK=https://scholarlyhelp.com/

# ClickUp
CLICKUP_BASE_URL=https://api.clickup.com/api/v3
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
# Set one target type:
# 1) Channel alerts
CLICKUP_CHANNEL_ID=
# 2) Direct-message alerts
CLICKUP_DM_USER_ID=
CLICKUP_TIMEOUT_SECONDS=10

# Optional auto schema setup for local bootstrap
AUTO_CREATE_SCHEMA=false
